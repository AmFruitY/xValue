# ── MinIO ────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is never committed to Git (see .gitignore)

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=xvalue-data

# ── Airflow ───────────────────────────────────────────────────────────────────
# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_CRYPTOGRAPHY

# Password for the Airflow web UI admin user
AIRFLOW_WWW_USER_PASSWORD=admin

# ── PostgreSQL (Airflow metadata DB) ─────────────────────────────────────────
POSTGRES_PASSWORD=airflow
